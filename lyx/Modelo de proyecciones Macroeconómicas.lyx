\begin_layout Section
Definiciones
\end_layout

\begin_layout Standard
A continuación se presentan un conjunto de definiciones separadas del núcleo del modelo.
\end_layout

\begin_layout Subsection*
Déficit fiscal
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\widetilde{\left(\frac{Def}{PIB}\right)}_{t}=\widetilde{\left(\frac{GFun}{PIB}\right)}_{t}+\widetilde{\left(\frac{IPub}{PIB}\right)}_{t}-\widetilde{\left(\frac{IngT}{PIB}\right)}_{t}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsection*
Deuda pública total
\begin_inset Foot
status open

\begin_layout Plain Layout
La ecuación (19) representa la ley de movimiento de la deuda pública total,
 en tanto que la ecuación (20) descompone la deuda pública total en un componente externo y otro interno.
 La compatibilidad de ambas definiciones se explica en la sección 4.
\end_layout

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\widetilde{\left(\frac{DPT}{PIB}\right)}_{t}=\widetilde{\left(\frac{DPT}{PIB}\right)}_{t-1}+\widetilde{\left(\frac{Def}{PIB}\right)}_{t}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\widetilde{\left(\frac{DPT}{PIB}\right)}_{t}=\widetilde{\left(\frac{DPE}{PIB}\right)}_{t}+\widetilde{\left(\frac{DPI}{PIB}\right)}_{t}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsection*
Base monetaria
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\widetilde{\left(\frac{MO}{PIB}\right)}_{t}=\widetilde{\left(\frac{AEN}{PIB}\right)}_{t}+\widetilde{\left(\frac{AIN}{PIB}\right)}_{t}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsection*
Inversión Total
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\widetilde{\left(\frac{ITotal}{PIB}\right)}_{t}=\widetilde{\left(\frac{IPub}{PIB}\right)}_{t}+\widetilde{\left(\frac{IPriv}{PIB}\right)}_{t}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsection*
Deuda pública interna consolidada
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\widetilde{\left(\frac{DPIC}{PIB}\right)}_{t}=\widetilde{\left(\frac{DPI}{PIB}\right)}_{t}-\widetilde{\left(\frac{AIN}{PIB}\right)}_{t}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsection*
Deuda pública externa consolidada
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\widetilde{\left(\frac{DPEC}{PIB}\right)}_{t}=\widetilde{\left(\frac{DPE}{PIB}\right)}_{t}-\widetilde{\left(\frac{AEN}{PIB}\right)}_{t}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsection*
Deuda pública total consolidada
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\widetilde{\left(\frac{DPTC}{PIB}\right)}_{t}=\widetilde{\left(\frac{DPEC}{PIB}\right)}_{t}+\widetilde{\left(\frac{DPIC}{PIB}\right)}_{t}
\end{equation}

\end_inset


\end_layout

\begin_layout Section
Sustitución de variables
\end_layout

\begin_layout Subsection*
Déficit fiscal en (9)
\end_layout

\begin_layout Standard
Sustituyendo la ecuación (18),
 rezagada un período,
 en la ecuación (9),
 se obtiene:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\widetilde{\left(\frac{DPI}{PIB}\right)}_{t}=\alpha_{9,1}\widetilde{\left(\frac{DPI}{PIB}\right)}_{t-1}+\alpha_{9,2}\widetilde{\left(\frac{DPE}{PIB}\right)}_{t-1}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
+\alpha_{9,3}\left[\widetilde{\left(\frac{GFun}{PIB}\right)}_{t-1}+\widetilde{\left(\frac{IPub}{PIB}\right)}_{t-1}-\widetilde{\left(\frac{IngT}{PIB}\right)}_{t-1}\right]+u_{9,t}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsection*
Deuda púbica externa consolidada en (13)
\end_layout

\begin_layout Standard
Sustituyendo la ecuación (24),
 rezagada un período,
 en la ecuación (13),
 resulta:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\widetilde{e}_{t}=\alpha_{13,1}\widetilde{e}_{t-1}+\alpha_{13,2}\left[\widetilde{\left(\frac{DPE}{PIB}\right)}_{t-1}-\widetilde{\left(\frac{AEN}{PIB}\right)}_{t-1}\right]+\alpha_{13,3}\left(\widetilde{i}_{t-1}-\widetilde{i}_{t-1}^{*}-\widetilde{\rho}_{t-1}\right)+u_{13,t}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsection*
Deuda pública total consolidada en (14)
\end_layout

\begin_layout Standard
Sustituyendo
\begin_inset Foot
